{
  "$id": "https://web-ui-quality.local/schemas/agent-benchmark-report.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "agentLoopStatus": {
      "type": "string"
    },
    "caseCount": {
      "minimum": 0,
      "type": "integer"
    },
    "claimBoundary": {
      "minLength": 1,
      "type": "string"
    },
    "comparability": {
      "type": "string"
    },
    "completedRuns": {
      "minimum": 0,
      "type": "integer"
    },
    "conditionAuthority": {
      "const": "CONTROLLER_PLANNED"
    },
    "conditionCohorts": {
      "type": "array"
    },
    "empiricalPassAtK": {
      "type": "object"
    },
    "eligibleRuns": {
      "minimum": 0,
      "type": "integer"
    },
    "falseVerified": {
      "type": "object"
    },
    "fixtureVersion": {
      "type": [
        "string",
        "null"
      ]
    },
    "kind": {
      "const": "REPORT"
    },
    "missingRuns": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "plannedRuns": {
      "minimum": 0,
      "type": "integer"
    },
    "protocolVersion": {
      "const": "4"
    },
    "regressionEscape": {
      "required": [
        "count",
        "rateAmongVerifiedClaims",
        "rateAmongAttemptedRepairs",
        "rateAmongSuccessfulRepairs",
        "denominators"
      ],
      "type": "object"
    },
    "repairSuccessRate": {
      "maximum": 1,
      "minimum": 0,
      "type": [
        "number",
        "null"
      ]
    },
    "repetitionsPerCase": {
      "minimum": 1,
      "type": "integer"
    },
    "rootCause": {
      "required": [
        "truePositive",
        "falsePositive",
        "falseNegative",
        "precision",
        "recall",
        "claimBoundary"
      ],
      "type": "object"
    },
    "invalidSetupRuns": {
      "minimum": 0,
      "type": "integer"
    },
    "infrastructureBlockedRuns": {
      "minimum": 0,
      "type": "integer"
    },
    "problemSolved": {
      "type": "object"
    },
    "schemaVersion": {
      "const": "4"
    },
    "successDenominator": {
      "minimum": 0,
      "type": "integer"
    },
    "scopePrecision": {
      "required": [
        "attemptedRepairRuns",
        "meanAmongAttemptedRepairs",
        "noOpExcluded"
      ],
      "type": "object"
    },
    "unmeasuredRuns": {
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "protocolVersion",
    "agentLoopStatus",
    "plannedRuns",
    "completedRuns",
    "missingRuns",
    "caseCount",
    "repetitionsPerCase",
    "conditionCohorts",
    "conditionAuthority",
    "comparability",
    "repairSuccessRate",
    "rootCause",
    "scopePrecision",
    "regressionEscape",
    "falseVerified",
    "empiricalPassAtK",
    "claimBoundary"
  ],
  "title": "Web UI Quality Agent Benchmark Report v4",
  "type": "object"
}
