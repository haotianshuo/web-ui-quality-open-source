{
  "$schema": "https://json-schema.org/draft/2020-12/schema.json",
  "$id": "https://web-ui-quality.local/schemas/host-write-receipt.schema.json",
  "title": "Host Write Receipt",
  "type": "object",
  "required": [
    "runId",
    "taskId",
    "sessionId",
    "findingIds",
    "sourceScope",
    "exclusions",
    "baselineDigest",
    "planDigest",
    "patchCandidateDigest",
    "toolchainDigest",
    "verificationContextDigest",
    "files",
    "scopeBaselineDigest"
  ],
  "properties": {
    "runId": {
      "type": "string",
      "pattern": "^wuq-[a-f0-9]{16,32}$"
    },
    "taskId": {
      "type": "string",
      "minLength": 1
    },
    "sessionId": {
      "type": "string",
      "minLength": 1
    },
    "findingIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "sourceScope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "exclusions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "baselineDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "planDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "patchCandidateDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "toolchainDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "verificationContextDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "beforeSha256",
          "afterSha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?![A-Za-z]:[\\/])(?!/)(?!\\\\)(?!.*(?:^|[\\/])\\.\\.(?:[\\/]|$)).+"
          },
          "beforeSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "afterSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "scopeBaselineDigest": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "additionalProperties": false
}
