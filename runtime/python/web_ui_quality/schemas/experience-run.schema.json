{
  "$schema": "https://json-schema.org/draft/2020-12/schema.json",
  "$id": "https://web-ui-quality.local/schemas/experience-run.schema.json",
  "title": "ExperienceRun v2",
  "type": "object",
  "required": [
    "schemaVersion",
    "runId",
    "taskId",
    "sessionId",
    "mode",
    "target",
    "targetDigest",
    "conditions",
    "conditionsDigest",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2"
    },
    "runId": {
      "type": "string",
      "pattern": "^wuq-[a-f0-9]{16,32}$"
    },
    "taskId": {
      "type": "string",
      "minLength": 1
    },
    "sessionId": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "CHECK",
        "FIX_AND_VERIFY",
        "DEEP_REDESIGN",
        "SPECIALIZED_AUDIT"
      ]
    },
    "target": {
      "type": "object"
    },
    "targetDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "conditions": {
      "type": "object"
    },
    "conditionsDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "createdAt": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
