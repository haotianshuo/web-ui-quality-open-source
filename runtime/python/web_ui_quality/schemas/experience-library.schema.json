{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://web-ui-quality.local/schemas/experience-library.schema.json",
  "title": "Experience Fusion Pattern Library",
  "type": "object",
  "required": [
    "schemaVersion",
    "metrics",
    "components",
    "pageSkeletons",
    "interactionPatterns",
    "contextualStates",
    "specialisedPatterns"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.1"
    },
    "metrics": {
      "type": "object"
    },
    "components": {
      "type": "array",
      "minItems": 30
    },
    "pageSkeletons": {
      "type": "array",
      "minItems": 50
    },
    "interactionPatterns": {
      "type": "array",
      "minItems": 100
    },
    "contextualStates": {
      "type": "array",
      "minItems": 200
    },
    "specialisedPatterns": {
      "type": "object"
    }
  },
  "additionalProperties": false
}