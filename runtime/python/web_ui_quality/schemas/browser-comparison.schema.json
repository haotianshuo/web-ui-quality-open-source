{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/web-ui-quality/browser-comparison.schema.json",
  "title": "Web UI Quality Browser Comparison Candidate Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "producer",
    "browser",
    "status",
    "beforeUrl",
    "afterUrl",
    "targetUrl",
    "beforeRef",
    "afterRef",
    "conditions",
    "viewports",
    "records",
    "journey",
    "step10",
    "warnings",
    "outputDirectory",
    "evidenceDigest"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1"
    },
    "producer": {
      "const": "web-ui-quality-playwright"
    },
    "browser": {
      "enum": [
        "chromium",
        "firefox",
        "webkit"
      ]
    },
    "authentication": {
      "type": "object"
    },
    "status": {
      "enum": [
        "PASS",
        "PASS_WITH_WARNINGS",
        "FAIL",
        "NOT_VERIFIED"
      ]
    },
    "beforeUrl": {
      "type": "string"
    },
    "afterUrl": {
      "type": "string"
    },
    "targetUrl": {
      "type": "string"
    },
    "beforeRef": {
      "type": "string"
    },
    "afterRef": {
      "type": "string"
    },
    "conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "viewports": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "width",
          "height"
        ],
        "properties": {
          "width": {
            "type": "integer",
            "minimum": 320
          },
          "height": {
            "type": "integer",
            "minimum": 480
          }
        },
        "additionalProperties": false
      }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "journey": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "step",
          "status",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "step": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "risk": {
            "type": "string"
          },
          "locator": {
            "type": "string"
          },
          "durationMs": {
            "type": "integer"
          },
          "url": {
            "type": "string"
          },
          "failureScreenshotRef": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "enum": [
              "PASS",
              "PASS_WITH_WARNINGS",
              "FAIL",
              "NOT_VERIFIED"
            ]
          },
          "reason": {
            "type": "string"
          },
          "locatorStrategy": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "traceRef": {
      "type": [
        "string",
        "null"
      ]
    },
    "visualDiff": {
      "type": "array"
    },
    "step10": {
      "type": "array"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "outputDirectory": {
      "type": "string"
    },
    "evidenceDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
