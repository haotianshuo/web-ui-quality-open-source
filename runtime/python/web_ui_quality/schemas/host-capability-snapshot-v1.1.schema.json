  "$id": "https://web-ui-quality.local/4.1/host-capability-snapshot-v1.1.schema.json",
  "title": "Host Capability Snapshot v1.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "snapshotId",
    "hostId",
    "hostVersion",
    "adapterId",
    "adapterVersion",
    "threatModelVersion",
    "channelAssessments",
    "issuedAt",
    "validUntil",
    "snapshotDigest",
    "integrityMechanism",
    "integrityTag"
