    "schemaVersion": {
      "const": "1.1"
    },
    "snapshotId": {
      "type": "string",
      "minLength": 1
    },
    "hostId": {
      "type": "string",
      "minLength": 1
    },
    "hostVersion": {
      "type": "string",
      "minLength": 1
    },
    "adapterId": {
      "type": "string",
      "minLength": 1
    },
    "adapterVersion": {
      "type": "string",
      "minLength": 1
    },
    "threatModelVersion": {
      "type": "string",
      "minLength": 1
    },
    "channelAssessments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/mutation"
          },
          {
            "$ref": "#/$defs/observation"
          },
          {
            "$ref": "#/$defs/identity"
          },
          {
            "$ref": "#/$defs/telemetry"
          },
          {
            "$ref": "#/$defs/context"
          },
          {
            "$ref": "#/$defs/execution"
          },
          {
            "$ref": "#/$defs/persistence"
          }
        ]
      }
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time"
    },
    "validUntil": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "previousSnapshotDigest": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "snapshotDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "integrityMechanism": {
      "enum": [
        "HOST_SIGNATURE",
        "HMAC_SHA256",
        "OPAQUE_HOST_ATTESTATION",
        "LOCAL_DIGEST_ONLY"
