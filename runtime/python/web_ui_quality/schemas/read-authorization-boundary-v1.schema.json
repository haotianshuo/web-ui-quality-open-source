{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://web-ui-quality.local/4.1/read-authorization-boundary-v1.schema.json",
  "title": "Read Authorization Boundary v1 (Phase1 Minimal)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "boundaryId",
    "taskId",
    "allowedRoots",
    "deniedRoots",
    "sensitiveRoots",
    "boundaryDigest"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1"
    },
    "boundaryId": {
      "type": "string",
      "minLength": 1
    },
    "taskId": {
      "type": "string",
      "minLength": 1
    },
    "allowedRoots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "deniedRoots": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "sensitiveRoots": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "boundaryDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
