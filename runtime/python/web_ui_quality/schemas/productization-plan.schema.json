{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/web-ui-quality/productization-plan.schema.json",
  "title": "Web UI Productization Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "businessUnderstanding",
    "currentFramework",
    "productArchetype",
    "pageModes",
    "mainProblems",
    "mustFix",
    "recommendedOptimizations",
    "enterpriseDifferences",
    "unverifiedItems",
    "recommendation",
    "selectionReason",
    "keyTradeoffs",
    "rejectedAlternative",
    "designInterventionLevel",
    "riskLevel",
    "approvedScope",
    "businessInvariants",
    "exclusions",
    "verificationPlan",
    "rollbackPlan"
  ],
  "properties": {
    "schemaVersion": {"const": "1"},
    "businessUnderstanding": {"type": "string", "minLength": 1},
    "currentFramework": {"type": "string", "minLength": 1},
    "productArchetype": {"type": "string", "minLength": 1},
    "pageModes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "mainProblems": {"type": "array", "items": {"type": "string"}},
    "mustFix": {"type": "array", "items": {"type": "string"}},
    "recommendedOptimizations": {"type": "array", "items": {"type": "string"}},
    "enterpriseDifferences": {"type": "array", "items": {"type": "string"}},
    "unverifiedItems": {"type": "array", "items": {"type": "string"}},
    "recommendation": {"type": "string", "minLength": 1},
    "selectionReason": {"type": "string", "minLength": 1},
    "keyTradeoffs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "rejectedAlternative": {"type": "string", "minLength": 1},
    "designInterventionLevel": {"type": "integer", "minimum": 1, "maximum": 3},
    "riskLevel": {"type": "string", "enum": ["R0", "R1", "R2", "R3"]},
    "approvedScope": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "businessInvariants": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "exclusions": {"type": "array", "items": {"type": "string"}},
    "verificationPlan": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "rollbackPlan": {"type": "string", "minLength": 1}
  }
}
