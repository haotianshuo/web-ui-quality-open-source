{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://web-ui-quality.local/4.1/claim-v2.schema.json",
  "title": "Claim v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "claimId",
    "taskId",
    "claimRole",
    "statement",
    "verificationContractId",
    "baselineId",
    "environmentFingerprint",
    "requiredEvidenceTypes",
    "evidenceIds",
    "requiredChannels",
    "capabilitySnapshotDigest",
    "receiptDigests",
    "status",
    "reasonCodes",
    "freshnessSummary",
    "evaluatedAt",
    "kernelVersion",
    "evaluationInputDigest",
    "claimDigest"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2"
    },
    "claimId": {
      "type": "string",
      "minLength": 1
    },
    "taskId": {
      "type": "string",
      "minLength": 1
    },
    "claimRole": {
      "enum": [
        "REQUIRED",
        "OPTIONAL",
        "DIAGNOSTIC"
      ]
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "verificationContractId": {
      "type": "string",
      "minLength": 1
    },
    "baselineId": {
      "type": "string",
      "minLength": 1
    },
    "environmentFingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "requiredEvidenceTypes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "evidenceIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "requiredChannels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "channelId",
          "minimumLevel",
          "purpose"
        ],
        "properties": {
          "channelId": {
            "type": "string"
          },
          "minimumLevel": {
            "enum": [
              "UNKNOWN",
              "UNAVAILABLE",
              "ADVISORY",
              "DETECT_ONLY",
              "ENFORCED"
            ]
          },
          "purpose": {
            "enum": [
              "WRITE_SAFETY",
              "INTEGRITY",
              "CONTEXT_ISOLATION_REQUIRED",
              "MEASUREMENT",
              "OPTIONAL_TELEMETRY",
              "IDENTITY_REQUIRED"
            ]
          }
        }
      }
    },
    "capabilitySnapshotDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "receiptDigests": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "uniqueItems": true
    },
    "status": {
      "enum": [
        "DECLARED",
        "EVALUATING",
        "VERIFIED",
        "NOT_VERIFIED",
        "NOT_MEASURED",
        "BLOCKED",
        "INVALIDATED"
      ]
    },
    "reasonCodes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "freshnessSummary": {
      "enum": [
        "FRESH",
        "STALE",
        "INVALID",
        "UNKNOWN_DEPENDENCY",
        "NOT_APPLICABLE"
      ]
    },
    "evaluatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "kernelVersion": {
      "type": "string",
      "minLength": 1
    },
    "evaluationInputDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "claimDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
