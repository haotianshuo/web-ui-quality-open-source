{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://web-ui-quality.local/schemas/capability-shadow-observation-v1.schema.json",
  "title": "WUQ Capability Shadow Observation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "observerVersion", "packageVersion", "kernelBaseVersion", "mode", "authoritative", "semanticSignalsUsed", "authorityEffect", "adaptiveEffect", "mechanicalSignals", "derivedDeterministicSignals", "summary", "claimBoundary", "signalSetDigest"],
  "properties": {
    "schemaVersion": {"const": "1"},
    "observerVersion": {"type": "string", "minLength": 1},
    "packageVersion": {"type": "string", "minLength": 1},
    "kernelBaseVersion": {"type": "string", "minLength": 1},
    "mode": {"const": "SHADOW_ONLY"},
    "authoritative": {"const": false},
    "semanticSignalsUsed": {"const": false},
    "authorityEffect": {"const": "NONE"},
    "adaptiveEffect": {"const": "NONE"},
    "mechanicalSignals": {"type": "array", "items": {"$ref": "#/$defs/signal"}},
    "derivedDeterministicSignals": {"type": "array", "items": {"$ref": "#/$defs/signal"}},
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signalCount", "capabilityEligibleSignalCount", "positiveCount", "negativeCount", "neutralCount", "profileRecommendation", "clampRecommendation"],
      "properties": {
        "signalCount": {"type": "integer", "minimum": 0},
        "capabilityEligibleSignalCount": {"type": "integer", "minimum": 0},
        "positiveCount": {"type": "integer", "minimum": 0},
        "negativeCount": {"type": "integer", "minimum": 0},
        "neutralCount": {"type": "integer", "minimum": 0},
        "profileRecommendation": {"const": "NOT_EVALUATED_UNTIL_SIGNAL_VALIDITY_GATE"},
        "clampRecommendation": {"const": "NOT_EVALUATED_UNTIL_SIGNAL_VALIDITY_GATE"}
      }
    },
    "claimBoundary": {"type": "string", "minLength": 1},
    "signalSetDigest": {"type": "string", "minLength": 16}
  },
  "$defs": {
    "signal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signalId", "kind", "code", "polarity", "source", "value", "capabilityEligible", "reasonCode", "authorityEffect", "adaptiveEffect"],
      "properties": {
        "signalId": {"type": "string", "minLength": 16},
        "kind": {"enum": ["MECHANICAL", "DERIVED_DETERMINISTIC"]},
        "code": {"type": "string", "minLength": 1},
        "polarity": {"enum": ["POSITIVE", "NEGATIVE", "NEUTRAL"]},
        "source": {"type": "string", "minLength": 1},
        "value": {},
        "capabilityEligible": {"type": "boolean"},
        "reasonCode": {"type": "string", "minLength": 1},
        "authorityEffect": {"const": "NONE"},
        "adaptiveEffect": {"const": "NONE"}
      }
    }
  }
}
