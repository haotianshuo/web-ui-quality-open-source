{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://web-ui-quality.local/schemas/journey.schema.json",
  "title": "Safe Browser Journey",
  "type": "array",
  "minItems": 1,
  "maxItems": 60,
  "items": {
    "type": "object",
    "required": [
      "action"
    ],
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "action": {
        "enum": [
          "goto",
          "click",
          "dblclick",
          "fill",
          "press",
          "select",
          "check",
          "uncheck",
          "wait_for",
          "assert_visible",
          "assert_hidden",
          "assert_text",
          "assert_value",
          "assert_checked",
          "assert_count",
          "assert_url",
          "screenshot",
          "back",
          "reload",
          "scroll",
          "hover",
          "focus"
        ]
      },
      "risk": {
        "enum": [
          "read-only",
          "ui-state",
          "submit",
          "destructive"
        ]
      },
      "name": {
        "type": "string"
      },
      "description": {
        "type": "string"
      },
      "selector": {
        "type": "string"
      },
      "role": {
        "type": "string"
      },
      "label": {
        "type": "string"
      },
      "placeholder": {
        "type": "string"
      },
      "testId": {
        "type": "string"
      },
      "text": {
        "type": "string"
      },
      "exact": {
        "type": "boolean"
      },
      "nth": {
        "type": "integer",
        "minimum": 0
      },
      "value": {
        "type": "string"
      },
      "expected": {},
      "contains": {
        "type": "string"
      },
      "textValue": {
        "type": "string"
      },
      "key": {
        "type": "string"
      },
      "url": {
        "type": "string"
      },
      "waitUntil": {
        "enum": [
          "commit",
          "domcontentloaded",
          "load",
          "networkidle"
        ]
      },
      "state": {
        "enum": [
          "attached",
          "detached",
          "visible",
          "hidden"
        ]
      },
      "x": {
        "type": "integer"
      },
      "y": {
        "type": "integer"
      },
      "filename": {
        "type": "string"
      },
      "fullPage": {
        "type": "boolean"
      },
      "outcome": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "signals"
        ],
        "properties": {
          "description": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "settleMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5000
          },
          "minimumSatisfied": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "signals": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "type": "object",
              "required": [
                "kind"
              ],
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "enum": [
                    "state_changed",
                    "url_contains",
                    "visible",
                    "hidden",
                    "text_contains",
                    "value_equals",
                    "checked_equals",
                    "count_equals",
                    "attribute_equals",
                    "request_observed",
                    "no_page_error",
                    "no_console_error"
                  ]
                },
                "evidenceRole": {
                  "enum": [
                    "user_visible",
                    "independent",
                    "persistence",
                    "recovery",
                    "supporting"
                  ]
                },
                "selector": {
                  "type": "string"
                },
                "role": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "placeholder": {
                  "type": "string"
                },
                "testId": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "exact": {
                  "type": "boolean"
                },
                "nth": {
                  "type": "integer",
                  "minimum": 0
                },
                "value": {},
                "attribute": {
                  "type": "string"
                },
                "urlContains": {
                  "type": "string"
                },
                "method": {
                  "type": "string"
                },
                "statusMin": {
                  "type": "integer",
                  "minimum": 100,
                  "maximum": 599
                },
                "statusMax": {
                  "type": "integer",
                  "minimum": 100,
                  "maximum": 599
                }
              }
            }
          }
        }
      }
    },
    "additionalProperties": false
  }
}
